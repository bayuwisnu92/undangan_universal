{
  "rewrites": [
    {
      "source": "/preview/(.*)",
      "destination": "/api/preview/$1"
    },
    {
      "source": "/api/preview/(.*)",
      "destination": "/api/preview/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}